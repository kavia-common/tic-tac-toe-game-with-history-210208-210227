[flake8]
# Only lint our source and tests; ignore third-party and build artifacts
exclude =
    .venv,
    venv,
    env,
    build,
    dist,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    node_modules,
    .git

# Reasonable line length
max-line-length = 100

# Per-file ignores for special cases
per-file-ignores =
    src/api/__init__.py:F401
