# Backend environment variables for Tic Tac Toe (FastAPI)

# SQLite file path (default to a local file). Use sqlite:///:memory: for ephemeral tests.
DATABASE_URL=sqlite:///./tictactoe.db

# Comma-separated list of allowed origins. Include your frontend preview URL here.
# Examples:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=https://vscode-internal-41094-beta.beta01.cloud.kavia.ai:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port for uvicorn when running locally
PORT=3001
