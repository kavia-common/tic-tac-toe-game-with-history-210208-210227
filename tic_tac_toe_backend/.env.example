# Backend environment configuration

# PUBLIC_INTERFACE
# Port for FastAPI/uvicorn to listen on (used by launcher scripts or deployment)
PORT=3001

# PUBLIC_INTERFACE
# SQLite DB file path (a relative path will be resolved from the backend working dir)
DB_PATH=./data/tictactoe.db

# PUBLIC_INTERFACE
# Comma-separated list of allowed CORS origins.
# Include localhost and the preview URLs to allow the React frontend to access the API.
CORS_ORIGINS=http://localhost:3000,https://vscode-internal-20447-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-20447-beta.beta01.cloud.kavia.ai:3001
