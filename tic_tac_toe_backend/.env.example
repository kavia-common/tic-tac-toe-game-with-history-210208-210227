# Backend environment example for tic_tac_toe_backend

# Database file path; default: ./data/tictactoe.db
# DB_PATH=/absolute/or/relative/path/to/tictactoe.db

# CORS configuration:
# Comma-separated list of origins allowed to call the API.
# If not set, sensible defaults for localhost are used. The FRONTEND_URL is also honored if set.
# CORS_ORIGINS=https://your-frontend.example.com,https://preview.example.com

# Recommended: explicitly set your frontend URL
# FRONTEND_URL=https://vscode-internal-20447-beta.beta01.cloud.kavia.ai:3000

# Optional: backend origin (used in defaults)
# BACKEND_ORIGIN=https://vscode-internal-20447-beta.beta01.cloud.kavia.ai:3001

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
