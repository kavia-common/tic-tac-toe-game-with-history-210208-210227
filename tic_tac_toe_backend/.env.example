# Backend environment example

# Database configuration
# SQLite file in project folder by default; unset to use in-memory (non-persistent)
DATABASE_URL=sqlite:///./tictactoe.db

# CORS configuration
# Comma-separated list of allowed origins. If left empty, local dev defaults are used:
# http://localhost:3000 and http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Automatic inclusion of the frontend origin (e.g., preview deployment URL)
# When set, this value is merged into the allowed CORS origins at startup.
# Example: https://vscode-internal-41094-beta.beta01.cloud.kavia.ai:3000
FRONTEND_URL=

# Local dev server port (used by uvicorn command in docs)
PORT=3001
